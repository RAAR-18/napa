@startuml

left to right direction

actor "Vendedor Ambulante" as va

rectangle "Gestionar entregas del vendedor ambulante" {
    usecase "Consultar ubicación de entrega" as UC1
    usecase "Iniciar entrega" as UC2
    usecase "Confirmar entrega directa" as UC3
}

usecase "Confirmar pago del pedido" as UC4

va --> UC1
va --> UC2
va --> UC3

UC3 .> UC4 : <<include>>

note right of UC1
  Aplica a pedidos aceptados de entrega directa
  y a reservas el día programado. El vendedor
  ambulante va hasta donde está el cliente.
end note

note right of UC3
  Aplica a pedidos aceptados de entrega directa
  y a reservas el día programado. El vendedor
  ambulante ve la dirección del cliente
  (dato que no existe en ningún otro RF, a
  diferencia del punto fijo que ya expone su
  ubicación en su emprendimiento).
end note

@enduml
