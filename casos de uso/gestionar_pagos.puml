@startuml

left to right direction

actor "Cliente" as c
actor "Vendedor" as v
actor "Domiciliario" as d
actor "Administrador" as adm

rectangle "Gestionar pagos" {
  usecase "Seleccionar metodo de pago" as UC1
  usecase "Confirmar pago de pedido" as UC2
  usecase "Confirmar pago domicilio" as UC3
  usecase "Configurar tarifa minima del domicilio" as UC4
  usecase "Consultar historial de pagos" as UC5
}

c --> UC1
c --> UC5

UC5 <-- adm
UC4 <-- adm

v --> UC2
v --> UC5

UC3 <-- d
UC5 <-- d
@enduml