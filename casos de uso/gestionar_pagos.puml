@startuml

left to right direction

actor "Cliente" as c
actor "Vendedor" as v
actor "Domiciliario" as d
actor "Administrador" as adm

rectangle "Gestionar pagos" {
  usecase "Confirmar pago del pedido" as UC1
  usecase "Confirmar pago del domicilio" as UC2
  usecase "Configurar tarifa mínima del domicilio" as UC3
  usecase "Consultar historial de pagos" as UC4
}

v --> UC1
d --> UC2
adm --> UC3

c --> UC4
v --> UC4
d --> UC4
adm --> UC4

note right of UC1
  El cliente elige efectivo o transferencia al hacer
  el pedido (los domicilios solo admiten transferencia).
  La plataforma no procesa el dinero: registra el
  método elegido y la confirmación del pago.
end note

@enduml
