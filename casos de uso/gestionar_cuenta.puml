@startuml

left to right direction

actor "Usuario" as u
actor "Cliente" as c
actor "Vendedor" as v
actor "Vendedor Ambulante" as va
actor "Vendedor de Punto Fijo" as vpf
actor "Domiciliario" as d
actor "Administrador" as adm

c --|> u
v --|> u
d --|> u
va --|> v
vpf --|> v

rectangle "Gestionar cuenta" {
  usecase "Crear una cuenta" as UC1
  usecase "Editar mi cuenta" as UC2
  usecase "Cambiar contraseña" as UC3
  usecase "Iniciar sesión en mi cuenta" as UC4
  usecase "Eliminar mi cuenta" as UC5
  usecase "Verificar celular con código" as UC6
}

u --> UC1
u --> UC2
u --> UC3
u --> UC4
u --> UC5

UC4 <-- adm
UC3 <-- adm

UC1 .> UC6 : <<include>>
UC6 .> UC2 : <<extend>>
UC6 .> UC3 : <<extend>>

note right of UC1
  Al crear la cuenta el usuario elige su rol:
  Cliente, Vendedor Ambulante,
  Vendedor de Punto Fijo o Domiciliario.
end note

note right of UC6
  Código de un solo uso por WhatsApp (SMS de respaldo).
  Verifica el celular al crear la cuenta, al cambiarlo
  y al recuperar la contraseña. No reemplaza la contraseña
  para iniciar sesión. El administrador no lo usa.
end note

@enduml
