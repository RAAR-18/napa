@startuml

left to right direction

actor "Vendedor" as v

rectangle "Gestionar productos" {
    usecase "Añadir producto" as UC1
    usecase "Listar productos" as UC2
    usecase "Editar producto" as UC3
    usecase "Actualizar cantidad producto" as UC4
    usecase "Eliminar producto" as UC5
    usecase "Consultar predicción de demanda" as UC6
}

v --> UC1
v --> UC2
v --> UC6

UC3 .> UC2 : <<extend>>
UC4 .> UC2 : <<extend>>
UC5 .> UC2 : <<extend>>

note right of UC6
  La predicción también alimenta la disponibilidad
  prevista que el cliente ve al hacer una reserva.
end note

@enduml
