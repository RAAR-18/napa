@startuml

left to right direction

actor "Cliente" as c
actor "Vendedor de Punto Fijo" as vpf
actor "Domiciliario" as d
actor "Administrador" as adm

rectangle "Gestionar domicilios" {
    ' Vendedor de punto fijo
    usecase "Publicar domicilio" as UC1
    usecase "Listar domicilios" as UC2
    usecase "Consultar estado del domicilio" as UC3
    usecase "Consultar información del domiciliario" as UC4
    usecase "Confirmar salida del domiciliario" as UC5

    ' Domiciliario
    usecase "Listar domicilios disponibles" as UC6
    usecase "Archivar domicilio" as UC7
    usecase "Consultar domicilios archivados" as UC8
    usecase "Consultar información del domicilio" as UC9
    usecase "Aceptar domicilio" as UC10
    usecase "Ofertar precio del domicilio" as UC11
    usecase "Consultar ruta en el mapa" as UC12
    usecase "Confirmar recogida del pedido" as UC13
    usecase "Confirmar entrega del pedido" as UC14

    ' Cliente
    usecase "Consultar ofertas de precio" as UC15
    usecase "Aceptar oferta de precio" as UC16
    usecase "Rechazar oferta de precio" as UC17
    usecase "Consultar trazabilidad del domicilio" as UC18
    usecase "Confirmar llegada del pedido" as UC19

    ' Administrador
    usecase "Consultar domicilios" as UC20
    usecase "Cancelar domicilio" as UC21
}

vpf --> UC1
vpf --> UC2
vpf --> UC5

d --> UC6
d --> UC8
d --> UC12
d --> UC13
d --> UC14

c --> UC15
c --> UC18
c --> UC19

adm --> UC20

UC3 .> UC2 : <<extend>>
UC4 .> UC3 : <<extend>>
UC4 .> UC18 : <<extend>>

UC7 .> UC6 : <<extend>>
UC9 .> UC6 : <<extend>>
UC10 .> UC9 : <<extend>>
UC11 .> UC9 : <<extend>>

UC16 .> UC15 : <<extend>>
UC17 .> UC15 : <<extend>>

UC21 .> UC20 : <<extend>>

note right of UC1
  Solo para pedidos de domicilio ya aceptados.
  Punto A = punto fijo, punto B = ubicación del cliente.
  Un domicilio publicado no puede editarse.
end note

note right of UC9
  Muestra de dónde sale, a dónde va,
  quién lo recibe y cuánto ganaría.
end note

note right of UC12
  Disponible cuando el domicilio queda asignado:
  el domiciliario acepta la tarifa publicada o
  el cliente acepta su oferta.
end note

note right of UC14
  Cierre en dos pasos: el domiciliario confirma
  la entrega y el cliente confirma la llegada.
end note

@enduml
