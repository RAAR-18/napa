@startuml

left to right direction

actor "Cliente" as c
actor "Vendedor de Punto Fijo" as vpf

rectangle "Gestionar reservas en punto fijo" {
    usecase "Consultar ubicación del punto de recogida" as UC1
    usecase "Marcar reserva como lista para recoger" as UC2
    usecase "Confirmar retiro de la reserva" as UC3
    usecase "Confirmar pago del pedido" as UC4
}

c --> UC1

vpf --> UC2
vpf --> UC3

UC3 .> UC4 : <<include>>

note right of UC1
  El cliente va hasta el punto fijo
  y recoge la reserva personalmente.
end note

note right of UC4
  Cobro en efectivo al retirar la reserva.
end note

@enduml
