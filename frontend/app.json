{
  "expo": {
    "name": "Ñapa",
    "slug": "napa",
    "owner": "raar-18-2",
    "description": "Conecta a vendedores locales con clientes cercanos.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "icon": "./assets/napa-icono-monograma.png",
      "adaptiveIcon": {
        "backgroundColor": "#321633",
        "foregroundImage": "./assets/napa-icono-monograma.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "co.edu.napa.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ñapa usa tu ubicación para mostrarte emprendimientos y domicilios cercanos y para guiarte en la ruta de entrega.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Ñapa comparte la ubicación de tu negocio móvil incluso cuando no usas la app, solo si lo activas. Puedes desactivarla en Mi emprendimiento."
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ñapa usa tus fotos solo para que elijas tu foto de perfil.",
          "cameraPermission": "Ñapa usa la cámara solo para que tomes tu foto de perfil."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "mapasAndroidHabilitados": false,
      "eas": {
        "projectId": "0886bc3e-582f-4281-a6a1-fa124e334a26"
      }
    }
  }
}
